{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*"]
}
